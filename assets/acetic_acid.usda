#usda 1.0
(
    defaultPrim = "Bottle"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Bottle" (
    prepend apiSchemas = ["PhysicsMassAPI"]
    prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/simready_content/common_assets/props/naturalbostonroundbottle_a03/naturalbostonroundbottle_a03.usd@
