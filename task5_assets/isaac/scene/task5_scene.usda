    def "Room"
    {
        def Cube "Floor" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            rel material:binding = </World/Looks/floor> (
                bindMaterialAs = "weakerThanDescendants"
            )
            double size = 1
            float3 xformOp:scale = (12, 12, 0.02)
            double3 xformOp:translate = (0.5, -0.5, -0.01)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "WallA" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            rel material:binding = </World/Looks/wall> (
                bindMaterialAs = "weakerThanDescendants"
            )
            double size = 1
            float3 xformOp:scale = (0.1, 6, 2.4)
            double3 xformOp:translate = (-0.51, -0.5, 1.2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "WallB" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            rel material:binding = </World/Looks/wall> (
                bindMaterialAs = "weakerThanDescendants"
            )
            double size = 1
            float3 xformOp:scale = (0.1, 6, 2.4)
            double3 xformOp:translate = (2.314, -0.5, 1.2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def "Lights"
    {
        def DomeLight "Dome"
        {
            float inputs:intensity = 800
        }

        def DistantLight "Key"
        {
            float inputs:intensity = 2500
            float3 xformOp:rotateXYZ = (-35, 25, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

    def Xform "LabBench"
